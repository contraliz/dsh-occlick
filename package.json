{
  "name": "dsh-occlick",
  "version": "0.4.1",
  "description": "Plays an OpenCode turn-end sound in DeepSeek Harness, with a sound picker on the Plugins page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "sound"
  ],
  "type": "module",
  "license": "MIT",
  "author": "contraliz",
  "homepage": "https://github.com/contraliz/dsh-occlick#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contraliz/dsh-occlick.git"
  },
  "bugs": {
    "url": "https://github.com/contraliz/dsh-occlick/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "fetch:sounds": "node scripts/fetch-sounds.mjs",
    "test": "node test/client.test.mjs",
    "prepublishOnly": "node scripts/build.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
